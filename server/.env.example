# ============================================================================
# Socratic AI server configuration. Copy to .env and fill in. All values have
# sane defaults except the two required secrets at the top.
# ============================================================================

# --- Required secrets ---
# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Neon (or any) Postgres — https://neon.tech
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --- Server ---
NODE_ENV=development          # 'production' makes missing secrets fatal + hides error details
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# --- Auth ---
ENABLE_WHITELIST=true         # set false only for local testing
AUTH_CACHE_TTL_MS=60000       # token->user cache TTL; 0 disables

# --- Rate limiting ---
RATE_LIMIT_PER_USER=10
RATE_LIMIT_GLOBAL=15          # protects the Gemini quota (2 calls/turn)
RATE_LIMIT_WINDOW_MS=60000

# --- Gemini models + token caps ---
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
GEMINI_GENERATOR_MODEL=gemini-2.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite
GEMINI_CLASSIFIER_MAX_TOKENS=448
GEMINI_GENERATOR_MAX_TOKENS=80
GEMINI_SUMMARY_MAX_TOKENS=350
GEMINI_GENERATOR_RETRIES=2

# --- Token-cost optimization ---
CLASSIFIER_COMPACT_TAXONOMY=true     # one-line taxonomy instead of full JSON
CLASSIFIER_CANDIDATE_PREFILTER=true  # only classify active+keyword+core misconceptions
CLASSIFIER_MAX_CANDIDATES=8

# --- Code context limits ---
MAX_CONTEXT_CHARS=24000
MAX_CONTEXT_LINES=60
SUMMARY_MAX_INPUT=8000

# --- Pedagogical thresholds (see docs/PLAN.md §4; keep in sync with the paper) ---
MC_NEUTRAL_CONFIDENCE=0.32
MC_DELTA_UP=0.22
MC_DELTA_DOWN=0.18
MC_DECAY=0.9
MC_RESOLUTION_THRESHOLD=0.18

# --- Automatic resolution detection ---
AUTO_RESOLVE_ENABLED=true     # false = always ask the learner to confirm instead of auto-closing
RESOLVE_CONFIRM_SCORE=0.7     # resolution score that prompts a confirmation
RESOLVE_AUTO_SCORE=0.9        # resolution score that may auto-close (with gating)
FRUSTRATION_TURNS=3           # consecutive low-progress turns before offering an off-ramp

# --- State cache ---
STATE_CACHE_MAX=500           # max sessions held in memory (LRU evicted; state is persisted)
