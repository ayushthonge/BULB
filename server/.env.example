# Gemini API (required) — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Neon Postgres (required) — get from https://neon.tech
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Auth whitelist (set to "false" to disable auth for testing)
ENABLE_WHITELIST=true

# Rate limiting
RATE_LIMIT_PER_USER=10
RATE_LIMIT_GLOBAL=15
RATE_LIMIT_WINDOW_MS=60000

# Server
PORT=3000
CORS_ORIGIN=*
